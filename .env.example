# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pizzashop
SPRING_DATASOURCE_USERNAME=pizzashop
SPRING_DATASOURCE_PASSWORD=change-me

# --- Admin area ---
# The first approved admin. Without it nobody can sign in to invite anyone else
# (docs/adr/0001-google-oauth-admin-auth.md).
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Google OAuth2 credentials, created once by hand in the Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
#
# Authorised redirect URI — register the origin the BROWSER sees, not the backend port.
# In local dev the Angular dev server proxies /oauth2 and /login to the backend without
# rewriting the Host header, so Spring builds the callback against :4200:
#   http://localhost:4200/login/oauth2/code/google
# When the SPA and API are served from one origin in production, register that origin:
#   https://your-domain.example/login/oauth2/code/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Where the Angular app is served from; used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:4200

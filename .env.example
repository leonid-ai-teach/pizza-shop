# Copy to .env and fill in. Never commit the real .env.
#
# Diese Datei bedient beide Startvarianten:
#   * docker compose up  — dann greifen die Werte unter "Docker-Stack"; die
#     SPRING_DATASOURCE_*-Werte weiter unten sind dabei ohne Wirkung, weil
#     docker-compose.yml sie selbst gegen den db-Container setzt.
#   * lokaler Start gegen ein eigenes PostgreSQL — dann greifen die SPRING_DATASOURCE_*-Werte.

# --- Docker-Stack (docker compose) ---
POSTGRES_DB=pizzashop
POSTGRES_USER=pizzashop
POSTGRES_PASSWORD=change-me

# Host-Port, unter dem der Stack erreichbar ist.
APP_PORT=8080
# Die Adresse, unter der der Browser den Stack sieht.
PUBLIC_URL=http://localhost:8080

# --- Database (lokaler Start ohne Docker, gegen eigenes PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pizzashop
SPRING_DATASOURCE_USERNAME=pizzashop
SPRING_DATASOURCE_PASSWORD=change-me

# --- Admin area ---
# Der erste Admin, angelegt beim Start. Beide Werte werden gebraucht: ohne Passwort koennte
# sich die Zeile nie anmelden (docs/adr/0003-admin-password-auth.md).
#
# Das Passwort wird nur beim allerersten Anlegen verwendet — spaetere Aenderungen ueber die
# Verwaltung werden bei einem Neustart nicht zurueckgesetzt. Mindestens 10 Zeichen.
#
# Achtung: Weil die Datenbank im Volume pizza-shop_pgdata liegt, ueberlebt ein geaendertes
# Passwort auch "docker compose up --build" — der Wert hier ist dann veraltet und die
# Anmeldung schlaegt fehl. Wie man ihn wieder gueltig macht, steht in README.md unter
# "Wenn die Anmeldung im Admin-Bereich fehlschlaegt".
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-too

# Where the Angular app is served from; used for CORS.
# Nur fuer den lokalen Start mit dem Angular-Dev-Server relevant — im Docker-Stack liegen SPA
# und API hinter demselben Origin und compose setzt diesen Wert aus PUBLIC_URL.
FRONTEND_URL=http://localhost:4200

# Vorlage fuer den Betrieb im Netz. Auf dem Server nach .env kopieren und ausfuellen —
# Compose liest immer .env, auch beim Start mit den Aufsatz-Dateien.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Die Werte hier sind Geheimnisse und gehoeren nie ins Git. Vorgehen: docs/deployment/deployment-oracle-inaktiv.md

# --- Welche Compose-Dateien gelten ---
# Spart das -f bei jedem Aufruf: "docker compose up -d" nimmt genau diese Dateien.
# Sobald GitHub Actions die Images baut, kommt ":docker-compose.registry.yml" ans Ende
# (Schritt 7 der Anleitung).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Domain und Zertifikat ---
# Die Domain, die auf die oeffentliche IP dieser Maschine zeigt. Ohne passenden DNS-Eintrag
# bekommt Caddy kein Zertifikat. Daraus ergibt sich auch die Adresse, die das Backend fuer
# sich selbst annimmt — einen zweiten Wert dafuer gibt es bewusst nicht.
PUBLIC_DOMAIN=pizza.example.com
# Adresse fuer die Ablaufwarnungen von Let's Encrypt.
ACME_EMAIL=you@example.com

# --- Datenbank ---
POSTGRES_DB=pizzashop
POSTGRES_USER=pizzashop
# Zufaellig erzeugen, nicht ausdenken:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Erster Admin ---
# Wird nur beim allerersten Start angelegt. Spaetere Aenderungen ueber die Verwaltung
# ueberleben einen Neustart (docs/adr/0003-admin-password-auth.md); dieser Wert wird dann
# nicht mehr angefasst. Mindestens 10 Zeichen.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Images aus der Registry (erst ab Schritt 7 der Anleitung) ---
# Alles klein geschrieben, KONTO und REPOSITORY durch die eigenen Namen ersetzen. Fuer einen
# Rueckzug auf eine aeltere Version steht statt "latest" der Commit-Hash aus dem Actions-Lauf.
#BACKEND_IMAGE=ghcr.io/konto/repository-backend:latest
#FRONTEND_IMAGE=ghcr.io/konto/repository-frontend:latest

# --- Nicht noetig ---
# APP_PORT und die SPRING_DATASOURCE_*-Werte aus .env.example spielen hier keine Rolle:
# nach aussen geht nur der Caddy auf 80 und 443, und die Datenbankverbindung setzt
# docker-compose.yml selbst gegen den db-Container.
